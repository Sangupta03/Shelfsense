# Copy this file to .env and fill in real values. .env is git-ignored.

# Postgres connection string (Neon "dev" branch, or a local Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/shelfsense?sslmode=require"

# where the python parser runs, and the shared secret it expects
PARSER_URL="http://localhost:8001"
PARSER_TOKEN="change-me-to-a-long-random-string"

# optional - free key at https://aistudio.google.com/apikey
# leave it empty and the routine coach uses the built-in rules instead
GEMINI_API_KEY=""
# tried in order - if one is rate limited (429) or overloaded (503), the next one is used
GEMINI_MODEL="gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-flash-lite-preview"

PORT=3000
NODE_ENV=development
